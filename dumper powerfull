-- ============================================================
-- 4. SCANNING & DUMP LOGIC
-- ============================================================
local activeThreads = 0
local isDumping = false
local scriptsSaved = 0
local decompileCache = {}

local function waitForThread()
    while activeThreads >= CONFIG.Threads do
        task.wait(CONFIG.Delay)
    end
end

local function collectScripts()
    local list, seen, scanned = {}, {}, 0
    local function add(inst)
        if inst:IsA("LuaSourceContainer") and not isIgnored(inst) then
            local ok, hash = pcall(function() 
                return hashFn and hashFn(inst) or inst:GetFullName() 
            end)
            local key = ok and hash or inst
            
            if not seen[key] then
                seen[key] = true
                table.insert(list, inst)
            end
        end
    end

    setStatus("Scanning scripts...")
    for _, desc in ipairs(game:GetDescendants()) do
        scanned = scanned + 1
        if scanned % 2000 == 0 then
            setStatus(("Scanning... %d"):format(scanned))
            task.wait()
        end
        add(desc)
    end

    if CONFIG.IncludeNil and nilInstancesFn then
        setStatus("Scanning nil scripts...")
        local ok, nils = pcall(nilInstancesFn)
        if ok and type(nils) == "table" then
            for _, inst in ipairs(nils) do pcall(add, inst) end
        end
    end

    if CONFIG.IncludeGC and getgcFn then
        setStatus("Scanning GC memory...")
        local ok, gc = pcall(getgcFn, true)
        if ok and type(gc) == "table" then
            for _, obj in ipairs(gc) do
                pcall(function()
                    if typeof(obj) == "Instance" and obj:IsA("LuaSourceContainer") then
                        add(obj)
                    end
                end)
            end
        end
    end
    return list
end

local function collectRemotes()
    local remotes = {}
    for _, inst in ipairs(game:GetDescendants()) do
        if inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") or inst:IsA("UnreliableRemoteEvent") then
            table.insert(remotes, { Type = inst.ClassName, Path = getFullName(inst) })
        end
    end
    return remotes
end

-- Collects TouchInterests, ClickDetectors, and ProximityPrompts
local function collectInteractables()
    local interactables = {}
    if not CONFIG.IncludeTouches then return interactables end
    
    setStatus("Scanning Interactables...")
    local scanned = 0
    for _, inst in ipairs(game:GetDescendants()) do
        scanned = scanned + 1
        if scanned % 5000 == 0 then task.wait() end 
        
        if inst:IsA("ProximityPrompt") then
            table.insert(interactables, { Type = "ProximityPrompt", Path = getFullName(inst) })
        elseif inst:IsA("ClickDetector") then
            table.insert(interactables, { Type = "ClickDetector", Path = getFullName(inst) })
        elseif inst:IsA("BasePart") then
            local success, touchObj = pcall(function() return inst:FindFirstChildOfClass("TouchInterest") end)
            if success and touchObj then
                table.insert(interactables, { Type = "TouchPart", Path = getFullName(inst) })
            end
        end
    end
    return interactables
end

local function runDump()
    ensureFolders()
    setProgress(0)
    scriptsSaved = 0
    logBuffer = {}

    local scriptList = collectScripts()
    local total = #scriptList
    if total == 0 then
        setStatus("No scripts found.")
        log("Nothing to dump.")
        return
    end

    setStatus("Scanning Remotes...")
    local remotesList = collectRemotes()
    local interactablesList = collectInteractables()

    log(("Found %d remotes, %d interactables."):format(#remotesList, #interactablesList))
    setStatus(("Dumping %d scripts..."):format(total))

    if CONFIG.DisableRender then
        pcall(function() RunService:Set3dRenderingEnabled(false) end)
    end

    local completed = 0
    local results = {}

    local function tick()
        completed = completed + 1
        setProgress((completed / total) * 100)
        setStatus(("Dumped %d/%d"):format(completed, total))
    end

    for idx, scriptObj in ipairs(scriptList) do
        waitForThread()
        activeThreads = activeThreads + 1
        task.spawn(function()
            local ok, err = pcall(function()
                local path = getFullName(scriptObj)
                if CONFIG.ReplaceUsername and plrName and #plrName > 1 then
                    path = path:gsub(plrName, "LocalPlayer")
                end

                local code
                if CONFIG.Decompile then
                    local key = scriptObj.ClassName .. ":" .. scriptObj.Name
                    code = decompileCache[key]
                    if not code then
                        code = tryDecompile(scriptObj)
                        if code then decompileCache[key] = code end
                    end
                end

                if not code and CONFIG.ExtractConsts and getconstantsFn then
                    local constOk, consts = pcall(getconstantsFn, scriptObj)
                    if constOk and type(consts) == "table" then
                        local validConsts = {}
                        for _, c in ipairs(consts) do
                            if type(c) == "string" then
                                table.insert(validConsts, string.format("%q", c))
                            end
                        end
                        if #validConsts > 0 then
                            code = "-- [Decompilation failed. Extracted String Constants below]\n" ..
                                   "return {\n    " .. table.concat(validConsts, ",\n    ") .. "\n}"
                        end
                    end
                end

                if not code then code = "-- [decompilation unavailable]" end

                local requires = {}
                for reqId in code:gmatch("require%s*%(?%s*(%d+)%s*%)?") do
                    table.insert(requires, reqId)
                end
                local reqString = ""
                if #requires > 0 then
                    reqString = "-- Dependencies (Requires): " .. table.concat(requires, ", ") .. "\n"
                end

                results[idx] = ("-- ==========================================\n" ..
                                "-- Script: %s\n" ..
                                "-- Class: %s\n" ..
                                "-- Path: %s\n" ..
                                "%s" ..
                                "-- ==========================================\n\n%s\n\n"):format(
                    scriptObj.Name, scriptObj.ClassName, path, reqString, code)
                
                scriptsSaved = scriptsSaved + 1
                log(("Dumped: %s"):format(scriptObj.Name))
            end)

            if not ok then
                results[idx] = ("-- [ERROR DUMPING %s]: %s\n\n"):format(tostring(scriptObj.Name), tostring(err))
                log(("Error: %s"):format(tostring(scriptObj.Name)))
            end

            activeThreads = activeThreads - 1
            tick()
        end)
    end

    while activeThreads > 0 do task.wait(0.1) end

    if CONFIG.DisableRender then
        pcall(function() RunService:Set3dRenderingEnabled(true) end)
    end

    setStatus("Saving file...")
    log("Writing to disk...")
    task.wait(0.2)

    local success, writeErr = pcall(function()
        local baseHeader = ("-- AbsoluteDumper Ultimate+ Output\n-- Place: %s\n-- Total Scripts: %d\n\n"):format(game.PlaceId, scriptsSaved)
        writefile(finalFilePath, baseHeader)
        
        local remoteHeader = "-- ==========================================\n" ..
                             ("-- REMOTE OBJECTS FOUND (%d)\n"):format(#remotesList) ..
                             "-- ==========================================\n"
        for _, remote in ipairs(remotesList) do
            remoteHeader = remoteHeader .. ("-- %s: %s\n"):format(remote.Type, remote.Path)
        end
        appendFn(finalFilePath, remoteHeader .. "\n\n")
        
        local interactHeader = "-- ==========================================\n" ..
                               ("-- INTERACTABLES FOUND (%d)\n"):format(#interactablesList) ..
                               "-- ==========================================\n"
        appendFn(finalFilePath, interactHeader)

        local interactChunk = ""
        for i, item in ipairs(interactablesList) do
            interactChunk = interactChunk .. ("-- %s: %s\n"):format(item.Type, item.Path)
            if #interactChunk > 100000 or i == #interactablesList then
                appendFn(finalFilePath, interactChunk)
                interactChunk = ""
                task.wait()
            end
        end
        appendFn(finalFilePath, "\n\n")

        local chunk = ""
        for i = 1, #results do
            if results[i] then
                chunk = chunk .. results[i]
                if #chunk > 500000 or i == #results then
                    appendFn(finalFilePath, chunk)
                    chunk = "" 
                    task.wait(0.05)
                end
            end
        end
    end)

    if success then
        setProgress(100)
        setStatus("Complete!")
        log(("Saved %d scripts, %d remotes, %d interactables."):format(scriptsSaved, #remotesList, #interactablesList))
    else
        setStatus("Failed to save.")
        log("Error: " .. tostring(writeErr))
    end
end

StartBtn.MouseButton1Click:Connect(function()
    if isDumping then return end
    isDumping = true
    StartBtn.Text = "Dumping..."
    StartBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    
    task.spawn(function()
        local ok, err = pcall(runDump)
        isDumping = false
        StartBtn.Text = "Start Dump"
        StartBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        
        if not ok then
            setStatus("Error.")
            log("Fatal: " .. tostring(err))
            pcall(function() RunService:Set3dRenderingEnabled(true) end)
        end
    end)
end)

