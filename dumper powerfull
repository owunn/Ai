local nilInstancesFn = getnilinstances or get_nil_instances
local decompileFn = (type(decompile) == "function") and decompile or nil
local bytecodeFn = (type(getscriptbytecode) == "function") and getscriptbytecode or nil
local hashFn = (type(getscripthash) == "function") and getscripthash or nil
local getgcFn = (type(getgc) == "function") and getgc or nil
local getconstantsFn = (type(debug) == "table" and type(debug.getconstants) == "function") and debug.getconstants or nil
local appendFn = appendfile or function(p, c)
    local old = readfile(p)
    writefile(p, old .. c)
end

