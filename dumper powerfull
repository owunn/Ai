-- 3. CONFIG
-- ============================================================
local CONFIG = {
    Decompile       = true,
    Threads         = 5,
    Delay           = 0.05,
    IncludeNil      = true,
    IncludeGC       = true, 
    ExtractConsts   = true, 
    IncludeTouches  = true, 
    ReplaceUsername = true,
    DisableRender   = true,
    OutputFolder    = "AbsoluteDumper",
    FileName        = "Combined_Dump.lua",
}

local plrName = Players.LocalPlayer and Players.LocalPlayer.Name or nil

local ignoredServices = { "Chat", "CoreGui", "CorePackages" }
local ignoredScripts  = { "PlayerModule", "RbxCharacterSounds", "PlayerScriptsLoader", "ChatScript", "BubbleChat" }

local function getPlaceName()
    local ok, info = pcall(function() return MarketplaceService:GetProductInfo(game.PlaceId) end)
    if ok and info and info.Name then
        return (info.Name:gsub("[\\/:*?\"<>|\n\r]", " "))
    end
    return "Unknown"
end

local outputDir  = CONFIG.OutputFolder
local folderName = ("%s/[%s] %s"):format(outputDir, tostring(game.PlaceId), getPlaceName())
local finalFilePath = folderName .. "/" .. CONFIG.FileName

local function ensureFolders()
    if not isfolder(outputDir) then makefolder(outputDir) end
    if not isfolder(folderName) then makefolder(folderName) end
end

local function isIgnored(instance)
    for _, svcName in ipairs(ignoredServices) do
        if instance:FindFirstAncestor(svcName) then return true end
    end
    for _, name in ipairs(ignoredScripts) do
        if instance.Name == name or instance:FindFirstAncestor(name) then return true end
    end
    return false
end

local function escapeName(name)
    if name:find("[^%w_]") then
        return ("['%s']"):format((name:gsub("'", "\\'")))
    end
    return name
end

local function getFullName(instance)
    local ok, fullName = pcall(function() return instance:GetFullName() end)
    if not ok or not fullName then return "--[unresolvable] " .. tostring(instance.Name) end
    if not instance:IsDescendantOf(game) then return "--[nil/gc script] " .. fullName end
    local parts = fullName:split(".")
    if #parts < 2 then return ("game:GetService(\"%s\")"):format(parts[1]) end
    
    local result = ("game:GetService(\"%s\")"):format(parts[1])
    for i = 2, #parts do
        result = result .. "." .. escapeName(parts[i])
    end
    return result
end

local function tryDecompile(scriptObj)
    if decompileFn then
        local ok, r = pcall(decompileFn, scriptObj)
        if ok and type(r) == "string" and #r > 0 then return r end
    end
    if bytecodeFn then
        local ok, r = pcall(bytecodeFn, scriptObj)
        if ok and type(r) == "string" then
            return "--[bytecode fallback]\n" .. r
        end
    end
    return nil
end

